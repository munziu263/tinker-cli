# Generated by build.py from garden.json: rebuild with `python build.py`
textures/
out/
viewer/model/

# Captured from the camera: video stills and the survey point cloud.
# Kept out of the repository on purpose (it is public). See README.md.
viewer/frames/
viewer/frames.json
tools/survey/survey.npz

# The inside of the house: room layout from the floor plans and notes from the interior clips.
# Private by default. build.py adds it to the model when the file is present.
interior.json

# the capture folder holds the printable markers and nothing from the camera
capture/*
!capture/markers_a4.pdf

# everything private on a local machine: photographs, frames, reconstructions, surveys,
# and the notes that say where the work stands
private/
CLAUDE.local.md
.venv/
